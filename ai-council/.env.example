# 每个实例目录（~/ai-council、~/ai-codex、~/ai-claude）各有一个 .env，权限 600，不进 Git。
# Each instance dir has its own .env (mode 600, never committed). Prefer scripts/set_secret.py to write secrets.

# deepseek | codex | claude
BOT_ROLE=deepseek
# 从 @BotFather 获得；每个实例一个不同的机器人 / from @BotFather, one bot per instance
TELEGRAM_BOT_TOKEN=
# 允许使用的聊天，逗号分隔（群是负数，私聊是正数）/ comma-separated allowed chat IDs
ALLOWED_CHAT_IDS=

# --- BOT_ROLE=deepseek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- BOT_ROLE=claude ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# --- BOT_ROLE=codex: 不需要 API key（用 ChatGPT 订阅登录的 codex CLI）/ no API key, uses `codex login` ---
