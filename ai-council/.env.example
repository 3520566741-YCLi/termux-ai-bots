# Mini PC：三个实例各一份 .env，在 ~/ai-council/runtime/<deepseek|claude|codex>/.env（权限 600，不进 Git）。
# 用 `council setup` 填写（输入密钥时不显示）。不要把密钥贴进聊天、提交到 Git 或写在命令行里。
# Each instance has its own .env under ~/ai-council/runtime/<role>/ (mode 600, never committed). Use `council setup`.

# deepseek（主持人，负责讨论） | claude | codex
BOT_ROLE=deepseek
# 从 @BotFather 获得；每个实例一个不同的机器人
TELEGRAM_BOT_TOKEN=
# 允许使用的聊天，逗号分隔（群是负数，私聊是正数）
ALLOWED_CHAT_IDS=
# 可选：监控告警发到哪些聊天（默认 ALLOWED_CHAT_IDS 里第一个群）
# ALERT_CHAT_IDS=

# --- BOT_ROLE=deepseek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 必填，代码里不写死模型名
DEEPSEEK_MODEL=

# --- BOT_ROLE=claude ---
# ANTHROPIC_API_KEY=
# 必填，代码里不写死模型名
# CLAUDE_MODEL=

# --- BOT_ROLE=codex：不需要 API key（用 ChatGPT 订阅登录的 codex CLI：council codex-login）---

# 可选工具（写在 runtime/tools/.env，三个实例共用）：GITHUB_TOKEN、TAVILY_API_KEY、NOTION_TOKEN、NOTION_PARENT_PAGE_ID
